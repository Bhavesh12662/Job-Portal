MONGODB_URI=mongodb://127.0.0.1:27017/careerflow
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Optional: configure SMTP to deliver OTP by email. Otherwise OTPs log to server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Careerflow <no-reply@careerflow.local>
# Twilio Verify SMS OTP (required in production when using SMS authentication)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
